# URL of the NestJS API (apps/api). Used by the Next.js server-side route
# handlers to forward submissions, list & delete on the owner's behalf.
# Leave the default for local dev — the API listens on :4000.
NEXT_PUBLIC_API_URL=https://sabbir-portfolio-api-3fh2.vercel.app

# Same ADMIN_TOKEN as in apps/api/.env. Server-only — never NEXT_PUBLIC_*.
# The Next proxy route handlers forward this as a Bearer header so the
# browser never sees the raw token.
ADMIN_TOKEN=sabbir-demo-token-2026