{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "prisma generate && npx nest build",
  "builds": [
    {
      "src": "src/vercel-entry.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 10
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/vercel-entry"
    }
  ]
}
