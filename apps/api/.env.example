# ─── API server ──────────────────────────────────────────────────────────
# Port the NestJS server listens on. Default: 4000.
PORT=4000

# Comma-separated list of origins allowed to call this API via CORS.
# Use the URL of the Next.js portfolio (no trailing slash).
CORS_ORIGIN=http://localhost:3000

# ─── Authentication ──────────────────────────────────────────────────────
# Single bearer token that grants access to the owner-only endpoints
# (GET /messages, DELETE /messages/:id). Treat this like a password:
# never commit it to git, rotate it if it's leaked.
#
# Generate a random one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=replace-me-with-a-long-random-secret

# ─── Database ───────────────────────────────────────────────────────────
# Postgres connection string. For Neon:
#   1. Sign up at https://neon.tech and create a project.
#   2. Copy the "pooled" connection string from the Neon dashboard.
#   3. Replace the user/password/host with your values, and append
#      ?sslmode=require if it's not already included.
#
# Examples:
#   Neon (pooled):   postgresql://USER:PASS@ep-xxx-pooler.eu-central-1.aws.neon.tech/portfolio?sslmode=require
#   Local Postgres: postgresql://postgres:postgres@localhost:5432/messages
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
