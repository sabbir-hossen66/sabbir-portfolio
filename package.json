{
  "name": "sabbir-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo root — orchestrates the Next.js frontend and NestJS API.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm --workspace @portfolio/web run dev",
    "dev:api": "npm --workspace @portfolio/api run start:dev",
    "build": "npm --workspace @portfolio/web run build",
    "build:web": "npm --workspace @portfolio/web run build",
    "build:api": "npm --workspace @portfolio/api run build",
    "start": "npm --workspace @portfolio/web run start",
    "lint": "npm --workspace @portfolio/web run lint",
    "lint:web": "npm --workspace @portfolio/web run lint",
    "lint:api": "npm --workspace @portfolio/api run lint",
    "type-check": "npm --workspace @portfolio/web run type-check",
    "type-check:web": "npm --workspace @portfolio/web run type-check",
    "type-check:api": "npm --workspace @portfolio/api run type-check"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4"
  }
}
